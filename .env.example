# AccessAtlas Environment Configuration Template
# Copy to .env.local for local overrides.
# .env.local is strictly ignored by version control.

# Application Environment (default: development)
APP_ENV=development

# Qloo Cultural Discovery API Configuration
# QLOO_API_KEY is optional at startup, required when invoking the Qloo client.
# The hackathon base URL is https://hackathon.api.qloo.com
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com
